<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:descendantFocusability="blocksDescendants">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_surface">

                <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_summary_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:theme_textColor="textColorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_incomes"
                            android:textSize="12sp"
                            app:theme_textColor="textColorSecondary" />

                        <TextView
                            android:id="@+id/summary_income_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="SAR 5,000" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_expenses"
                            android:textSize="12sp"
                            app:theme_textColor="textColorSecondary" />

                        <TextView
                            android:id="@+id/summary_expense_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="SAR 1,200" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_net_incomes"
                            android:textSize="12sp"
                            app:theme_textColor="textColorSecondary" />

                        <TextView
                            android:id="@+id/summary_net_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="SAR 3,800" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/overview_summary_balance"
                            android:textSize="12sp"
                            app:theme_textColor="textColorSecondary" />

                        <TextView
                            android:id="@+id/summary_balance_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="SAR 8,800" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:id="@+id/summary_comparison_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/overview_comparison_title"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:theme_textColor="textColorSecondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/overview_comparison_income"
                                android:textSize="11sp"
                                app:theme_textColor="textColorSecondary" />

                            <TextView
                                android:id="@+id/summary_income_change_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="SAR 500" />

                            <TextView
                                android:id="@+id/summary_income_change_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="11sp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="SAR: +10.0%" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/overview_comparison_expense"
                                android:textSize="11sp"
                                app:theme_textColor="textColorSecondary" />

                            <TextView
                                android:id="@+id/summary_expense_change_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="SAR 120" />

                            <TextView
                                android:id="@+id/summary_expense_change_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="11sp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="SAR: +8.0%" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/overview_comparison_net"
                            android:textSize="11sp"
                            app:theme_textColor="textColorSecondary" />

                        <TextView
                            android:id="@+id/summary_net_change_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="SAR 380" />

                        <TextView
                            android:id="@+id/summary_net_change_percent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="11sp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="SAR: +12.0%" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/summary_savings_rate_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/overview_savings_rate_title"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:theme_textColor="textColorSecondary" />

                    <TextView
                        android:id="@+id/summary_savings_rate_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="5"
                        android:ellipsize="end"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="SAR: +25.0%" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summary_top_expenses_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_surface">

                <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_top_expenses_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:theme_textColor="textColorPrimary" />

                <TextView
                    android:id="@+id/summary_top_expenses_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="SAR • Groceries: 450.00&#10;SAR • Transport: 220.00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summary_upcoming_events_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_surface">

                <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_upcoming_events_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:theme_textColor="textColorPrimary" />

                <TextView
                    android:id="@+id/summary_upcoming_events_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Family trip — 20 Nov 2026&#10;Insurance renewal — 24 Nov 2026" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/view_pie_chart_height"
            android:layout_marginStart="12dp"
            android:layout_marginTop="@dimen/view_pie_chart_margin_top"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="@dimen/view_pie_chart_margin_bottom"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/chart_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_surface">

            <com.oriondev.moneywallet.ui.view.theme.ThemedViewPagerIndicator
                android:id="@+id/view_pager_indicator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/view_pie_chart_indicator_height"
                android:layout_gravity="bottom|center_horizontal"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp" />

        </androidx.viewpager.widget.ViewPager>
        </com.google.android.material.card.MaterialCardView>

        <com.oriondev.moneywallet.ui.view.theme.ThemedRecyclerView
            app:systemBarInsetSides="@bool/panel_fills_window"
            app:systemBarInsetBottom="true"
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/material_component_lists_padding_top"
            android:paddingBottom="@dimen/material_component_lists_padding_bottom"
            android:clipToPadding="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>