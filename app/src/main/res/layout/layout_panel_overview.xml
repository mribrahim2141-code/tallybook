<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:descendantFocusability="blocksDescendants">

        <!-- Primary financial summary: a calm, high-contrast premium hero. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tally_screen_gutter"
            android:layout_marginTop="@dimen/tally_space_16"
            android:layout_marginEnd="@dimen/tally_screen_gutter"
            android:layout_marginBottom="@dimen/tally_space_12"
            app:cardBackgroundColor="@color/tally_brand_navy"
            app:cardCornerRadius="@dimen/tally_radius_large"
            app:cardElevation="1dp"
            app:strokeColor="@color/tally_brand_royal"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/tally_space_20"
                android:background="@drawable/bg_tally_overview_hero">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_summary_title"
                    android:textColor="#DCE8FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/overview_summary_balance"
                    android:textColor="#C5D2E8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/summary_balance_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/tally_text_balance"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="SAR 12,850.00" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:background="#40FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_incomes"
                            android:textColor="#BFD0EA"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/summary_income_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="SAR 5,000" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/tally_screen_gutter"
                        android:layout_marginEnd="@dimen/tally_screen_gutter"
                        android:background="#40FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_expenses"
                            android:textColor="#BFD0EA"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/summary_expense_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="SAR 1,200" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hint_net_incomes"
                        android:textColor="#BFD0EA"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/summary_net_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="SAR 3,800" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#40FFFFFF" />

                <LinearLayout
                    android:id="@+id/summary_comparison_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/overview_comparison_title"
                        android:textColor="#DCE8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/overview_comparison_income"
                                android:textColor="#BFD0EA"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/summary_income_change_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end"
                                tools:text="SAR 500" />

                            <TextView
                                android:id="@+id/summary_income_change_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#BFD0EA"
                                android:textSize="11sp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                tools:text="SAR: +10.0%" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tally_screen_gutter"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/overview_comparison_expense"
                                android:textColor="#BFD0EA"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/summary_expense_change_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end"
                                tools:text="SAR 120" />

                            <TextView
                                android:id="@+id/summary_expense_change_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#BFD0EA"
                                android:textSize="11sp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                tools:text="SAR: +8.0%" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/overview_comparison_net"
                            android:textColor="#BFD0EA"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/summary_net_change_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            tools:text="SAR 380" />

                        <TextView
                            android:id="@+id/summary_net_change_percent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="#BFD0EA"
                            android:textSize="11sp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            tools:text="SAR: +12.0%" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/summary_savings_rate_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/overview_savings_rate_title"
                        android:textColor="#DCE8FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/summary_savings_rate_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="5"
                        android:ellipsize="end"
                        tools:text="SAR: +25.0%" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summary_top_expenses_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tally_screen_gutter"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/tally_screen_gutter"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/tally_radius_medium"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_surface">

                <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_top_expenses_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:theme_textColor="textColorPrimary" />

                <TextView
                    android:id="@+id/summary_top_expenses_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="SAR • Groceries: 450.00&#10;SAR • Transport: 220.00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summary_upcoming_events_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tally_screen_gutter"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/tally_screen_gutter"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/tally_radius_medium"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_surface">

                <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_upcoming_events_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:theme_textColor="textColorPrimary" />

                <TextView
                    android:id="@+id/summary_upcoming_events_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Family trip — 20 Nov 2026&#10;Insurance renewal — 24 Nov 2026" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summary_upcoming_debts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tally_screen_gutter"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/tally_screen_gutter"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/tally_radius_medium"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_surface">

                <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_upcoming_debts_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:theme_textColor="textColorPrimary" />

                <TextView
                    android:id="@+id/summary_upcoming_debts_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Installment — 25 Nov 2026&#10;Personal loan — 30 Nov 2026" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summary_overdue_debts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tally_screen_gutter"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/tally_screen_gutter"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/tally_radius_medium"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_surface">

                <com.oriondev.moneywallet.ui.view.theme.ThemedTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overview_overdue_debts_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:theme_textColor="textColorPrimary" />

                <TextView
                    android:id="@+id/summary_overdue_debts_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Late installment — 10 Nov 2026 — remaining: SAR 350" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/view_pie_chart_height"
            android:layout_marginStart="@dimen/tally_screen_gutter"
            android:layout_marginTop="@dimen/view_pie_chart_margin_top"
            android:layout_marginEnd="@dimen/tally_screen_gutter"
            android:layout_marginBottom="@dimen/view_pie_chart_margin_bottom"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/tally_radius_large"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/chart_view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_surface">

            <com.oriondev.moneywallet.ui.view.theme.ThemedViewPagerIndicator
                android:id="@+id/view_pager_indicator"
                android:layout_width="match_parent"
                android:layout_height="@dimen/view_pie_chart_indicator_height"
                android:layout_gravity="bottom|center_horizontal"
                app:tabPaddingStart="0dp"
                app:tabPaddingEnd="0dp" />

        </androidx.viewpager.widget.ViewPager>
        </com.google.android.material.card.MaterialCardView>

        <com.oriondev.moneywallet.ui.view.theme.ThemedRecyclerView
            app:systemBarInsetSides="@bool/panel_fills_window"
            app:systemBarInsetBottom="true"
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/material_component_lists_padding_top"
            android:paddingBottom="@dimen/material_component_lists_padding_bottom"
            android:clipToPadding="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>