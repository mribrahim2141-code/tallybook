<resources>
    <color name="colorPrimary">#2457D6</color>
    <color name="colorAccent">#3D75F2</color>
    <color name="textPrimary">#DE171D2B</color>
    <color name="textSecondary">#8A536078</color>
    <color name="textPrimaryInverted">#DEE8EDF7</color>
    <color name="textSecondaryInverted">#8AAAB5C8</color>

    <!-- The dark alert dialog palette. These are the values Theme.AppCompat.Dialog.Alert resolves
         to, kept by hand because the AppCompat resources behind them are private. -->
    <color name="dialogDarkBackground">#FF172338</color>
    <color name="dialogDarkTextPrimary">#FFFFFFFF</color>
    <color name="dialogDarkTextSecondary">#B3AAB5C8</color>
    <color name="dialogDarkTextHint">#80AAB5C8</color>
    <color name="dialogDarkControlHighlight">#33FFFFFF</color>

    <!--
      ~ Painted over a system bar that the platform will not darken for us: the navigation bar below
      ~ Android 8, and the strip of the drawer behind the status bar. Half black over anything the
      ~ app draws leaves the light icons readable. Taken from androidx, which faces the same problem.
      -->
    <color name="system_bar_scrim_dark">#801B1B1B</color>

</resources>