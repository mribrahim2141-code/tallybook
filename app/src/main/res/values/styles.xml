        <item name="colorSurfaceDim">#101D18</item>
        <item name="colorSurfaceContainer">#1B2921</item>
        <item name="colorSurfaceContainerLow">#16231C</item>
        <item name="colorSurfaceContainerHigh">#25332B</item>
        <item name="colorSurfaceContainerLowest">#0B1510</item>
        <item name="colorSurfaceContainerHighest">#303E35</item>
