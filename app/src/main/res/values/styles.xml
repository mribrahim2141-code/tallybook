<resources>

    <!-- The app theme for the light mode. ThemedActivity swaps in one of the two below for the
         dark modes before super.onCreate, and recreates the activity when the mode changes. Not
         DayNight, because the mode is picked in the app and not taken from the system. The color
         roles were generated once from the default primary #3f51b5 with SchemeContent, the scheme
         the library seeds dynamic color from a single color with. The screens carry their
         own toolbar, so the parent's window action bar and title stay off. -->
    <style name="MoneyWalletAppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#006C50</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryInverse">#86DAB9</item>
        <item name="colorPrimaryContainer">#00513F</item>
        <item name="colorOnPrimaryContainer">#A5F2D1</item>
        <item name="colorPrimaryFixed">#A5F2D1</item>
        <item name="colorPrimaryFixedDim">#86DAB9</item>
        <item name="colorOnPrimaryFixed">#002116</item>
        <item name="colorOnPrimaryFixedVariant">#00513F</item>
        <item name="colorSecondary">#4B6358</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#CDE9D9</item>
        <item name="colorOnSecondaryContainer">#344B40</item>
        <item name="colorSecondaryFixed">#A5F2D1</item>
        <item name="colorSecondaryFixedDim">#B1CCBB</item>
        <item name="colorOnSecondaryFixed">#082016</item>
        <item name="colorOnSecondaryFixedVariant">#344B40</item>
        <item name="colorTertiary">#38656A</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#204D52</item>
        <item name="colorOnTertiaryContainer">#BCEBEF</item>
        <item name="colorTertiaryFixed">#BCEBEF</item>
        <item name="colorTertiaryFixedDim">#A0CFD3</item>
        <item name="colorOnTertiaryFixed">#002022</item>
        <item name="colorOnTertiaryFixedVariant">#204D52</item>
        <item name="android:colorBackground">#F5FAF6</item>
        <item name="colorOnBackground">#16231C</item>
        <item name="colorSurface">#F5FAF6</item>
        <item name="colorOnSurface">#16231C</item>
        <item name="colorSurfaceVariant">#DCE5DE</item>
        <item name="colorOnSurfaceVariant">#404A43</item>
        <item name="colorSurfaceInverse">#2B322D</item>
        <item name="colorOnSurfaceInverse">#ECF2EC</item>
        <item name="colorSurfaceBright">#F5FAF6</item>
        <item name="colorSurfaceDim">#D6DED7</item>
        <item name="colorSurfaceContainer">#EAF2EC</item>
        <item name="colorSurfaceContainerLow">#EFF6F0</item>
        <item name="colorSurfaceContainerHigh">#E4ECE6</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerHighest">#DEE7E0</item>
        <item name="colorOutline">#707B73</item>
        <item name="colorOutlineVariant">#C0CBC2</item>
        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFDAD6</item>
        <item name="colorOnErrorContainer">#93000A</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="drawerArrowStyle">@style/MoneyWalletDrawerArrowStyle</item>
        <item name="switchStyle">@style/Widget.AppCompat.CompoundButton.Switch</item>
        <!-- Material3 turns the overlay on, and it would tint the drawer and app bar colors
             ThemeEngine paints. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="appBarLayoutStyle">@style/MoneyWalletAppBarLayout</item>
    </style>

    <style name="MoneyWalletAppThemeDark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#86DAB9</item>
        <item name="colorOnPrimary">#003826</item>
        <item name="colorPrimaryInverse">#006C50</item>
        <item name="colorPrimaryContainer">#00513F</item>
