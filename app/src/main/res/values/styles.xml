        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="colorErrorContainer">#93000A</item>
        <item name="colorOnErrorContainer">#FFDAD6</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="drawerArrowStyle">@style/MoneyWalletDrawerArrowStyle</item>
        <item name="switchStyle">@style/Widget.AppCompat.CompoundButton.Switch</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="appBarLayoutStyle">@style/MoneyWalletAppBarLayout</item>
    </style>

    <!-- ThemeEngine paints the app bar. Material3 fades that paint to its own surface color once a
         list scrolls under the bar, and the toolbar and tabs keep their own paint, so only the
         strip behind the status bar and the side insets changed color. -->
    <style name="MoneyWalletAppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="liftOnScrollColor">@null</item>
    </style>

    <!-- The deep dark mode paints the list content black, so only the background and surface
         roles follow it. -->
    <style name="MoneyWalletAppThemeDeepDark" parent="MoneyWalletAppThemeDark">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceDim">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>
        <item name="colorSurfaceContainerHighest">#000000</item>
        <item name="colorSurfaceVariant">#000000</item>
        <item name="popupMenuBackground">@drawable/popup_background_deep_dark</item>
    </style>

    <style name="ThemeOverlay.MoneyWallet.DeepDark" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceDim">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerHigh">#000000</item>
        <item name="colorSurfaceContainerHighest">#000000</item>
        <item name="colorSurfaceVariant">#000000</item>
    </style>

    <!-- ThemedDialog picks one of these for every alert dialog in the app. Each keeps the
         dialog on the card color ThemeEngine paints in its mode, #FFFFFF, #424242 or
         #000000, the surface ThemedDialog checks the accent against. A Material3 dialog draws
         on colorSurfaceContainerHigh. -->
    <style name="MoneyWalletAlertDialogLight" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@android:color/white</item>
    </style>

    <style name="MoneyWalletAlertDialogDark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/dialogDarkBackground</item>
        <item name="colorSurface">@color/dialogDarkBackground</item>
        <item name="colorOnSurface">@color/dialogDarkTextPrimary</item>
        <item name="colorOnBackground">@color/dialogDarkTextPrimary</item>
        <item name="android:colorBackground">@color/dialogDarkBackground</item>
        <item name="android:textColorPrimary">@color/dialogDarkTextPrimary</item>
        <item name="android:textColorSecondary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorTertiary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorHint">@color/dialogDarkTextHint</item>
        <item name="colorControlNormal">@color/dialogDarkTextSecondary</item>
        <item name="colorControlHighlight">@color/dialogDarkControlHighlight</item>
    </style>

    <style name="MoneyWalletAlertDialogDeepDark" parent="MoneyWalletAlertDialogDark">
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- Every bottom sheet is handed one of these by name, picked the same way as the dialog
         styles above. A Material3 sheet draws on colorSurfaceContainerLow. -->
    <style name="MoneyWalletBottomSheetLight" parent="ThemeOverlay.Material3.BottomSheetDialog"/>

    <style name="MoneyWalletBottomSheetDark" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurfaceContainerLow">@color/dialogDarkBackground</item>
        <item name="colorSurface">@color/dialogDarkBackground</item>
        <item name="colorOnSurface">@color/dialogDarkTextPrimary</item>
        <item name="colorOnBackground">@color/dialogDarkTextPrimary</item>
        <item name="android:colorBackground">@color/dialogDarkBackground</item>
        <item name="android:textColorPrimary">@color/dialogDarkTextPrimary</item>
        <item name="android:textColorSecondary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorTertiary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorHint">@color/dialogDarkTextHint</item>
        <item name="colorControlNormal">@color/dialogDarkTextSecondary</item>
        <item name="colorControlHighlight">@color/dialogDarkControlHighlight</item>
    </style>

    <style name="MoneyWalletBottomSheetDeepDark" parent="MoneyWalletBottomSheetDark">
        <item name="colorSurfaceContainerLow">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- Both pickers are handed one of these by name through ThemedDialog, picked the same way.
         Both draw on colorSurfaceContainerHigh. -->
    <style name="MoneyWalletDatePickerLight" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorSurfaceContainerHigh">@android:color/white</item>
    </style>

    <style name="MoneyWalletDatePickerDark" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorSurfaceContainerHigh">@color/dialogDarkBackground</item>
        <item name="colorSurface">@color/dialogDarkBackground</item>
        <item name="colorOnSurface">@color/dialogDarkTextPrimary</item>
        <item name="colorOnBackground">@color/dialogDarkTextPrimary</item>
        <item name="android:colorBackground">@color/dialogDarkBackground</item>
        <item name="android:textColorPrimary">@color/dialogDarkTextPrimary</item>
        <item name="android:textColorSecondary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorTertiary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorHint">@color/dialogDarkTextHint</item>
        <item name="colorControlNormal">@color/dialogDarkTextSecondary</item>
        <item name="colorControlHighlight">@color/dialogDarkControlHighlight</item>
    </style>

    <style name="MoneyWalletDatePickerDeepDark" parent="MoneyWalletDatePickerDark">
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <style name="MoneyWalletTimePickerLight" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorSurfaceContainerHigh">@android:color/white</item>
    </style>

    <style name="MoneyWalletTimePickerDark" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorSurfaceContainerHigh">@color/dialogDarkBackground</item>
        <item name="colorSurface">@color/dialogDarkBackground</item>
        <item name="colorOnSurface">@color/dialogDarkTextPrimary</item>
        <item name="colorOnBackground">@color/dialogDarkTextPrimary</item>
        <item name="android:colorBackground">@color/dialogDarkBackground</item>
        <item name="android:textColorPrimary">@color/dialogDarkTextPrimary</item>
        <item name="android:textColorSecondary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorTertiary">@color/dialogDarkTextSecondary</item>
        <item name="android:textColorHint">@color/dialogDarkTextHint</item>
        <item name="colorControlNormal">@color/dialogDarkTextSecondary</item>
        <item name="colorControlHighlight">@color/dialogDarkControlHighlight</item>
