        <item name="colorTertiaryFixed">#BCEBEF</item>
        <item name="colorTertiaryFixedDim">#A0CFD3</item>
        <item name="colorOnTertiaryFixed">#002022</item>
        <item name="colorOnTertiaryFixedVariant">#204D52</item>
        <item name="android:colorBackground">#101D18</item>
        <item name="colorOnBackground">#DEE7E0</item>
        <item name="colorSurface">#101D18</item>
        <item name="colorOnSurface">#DEE7E0</item>
        <item name="colorSurfaceVariant">#404A43</item>
        <item name="colorOnSurfaceVariant">#C0CBC2</item>
        <item name="colorSurfaceInverse">#DEE7E0</item>
        <item name="colorOnSurfaceInverse">#2B322D</item>
