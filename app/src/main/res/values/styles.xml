    <style name="MoneyWalletTimePickerDeepDark" parent="MoneyWalletTimePickerDark">
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurfaceContainerHighest">#202020</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- The drawer icon morphs into the back arrow without spinning, as the drawer library's own
         style had it. -->
    <style name="MoneyWalletDrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">false</item>
    </style>

    <!-- A chip paints chipSurfaceColor under its background, and the default chip style takes it
         from colorSurface. The search rail gives an unset chip a transparent background, so in
         dark mode the chip drew as a white pill. Code cannot set the surface color, only a style
         can. -->
    <style name="SearchRailChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipSurfaceColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.SearchRailChip" parent="">
        <item name="chipStyle">@style/SearchRailChip</item>
    </style>

</resources>